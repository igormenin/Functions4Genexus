  <Objects>
    <Object type="00000000-0000-0000-0000-000000000008">
      <Properties>
        <Property refid="Func4Genexus_SDTs" />
      </Properties>
    </Object>
  </Objects>
  <Commands>
    <CommandDefinition id="Gerar ou Gerenciar SDT" context="selection" />
